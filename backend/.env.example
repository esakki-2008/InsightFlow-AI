# Backend configuration template. Copy to backend/.env for local development.
# Generate a strong value with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
INSIGHTFLOW_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Generate a Fernet key once and keep it stable across restarts/deployments:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Never commit the real key. Losing/changing it makes saved provider keys undecryptable.
INSIGHTFLOW_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# SQLite is the local default. Set a managed PostgreSQL URL in production.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Comma-separated exact frontend origins. Remote production origins must use HTTPS.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Shared authentication rate limiting for production (required when INSIGHTFLOW_ENV=production).
# REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_REDIS_HOST:6379/0
# INSIGHTFLOW_ENV=production
